{
  "name": "aipixel-architecture-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:content": "node --test tests/*.test.mjs && node scripts/audit-assets.mjs",
    "lint": "biome lint src tests scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:selects": "node scripts/verify-all-selects.mjs",
    "test:e2e": "node scripts/test-master-e2e.mjs",
    "test:buttons": "node scripts/test-all-buttons-e2e.js",
    "test:showcase": "node scripts/capture_readme_showcase.cjs",
    "test": "npm run check:content",
    "test:ai": "node --test tests/ai-academy.test.mjs",
    "test:security": "node --test tests/security-baseline.test.mjs",
    "test:ui": "vitest run",
    "check:release": "npm run test && npm run test:ai && npm run test:security && npm run test:ui && npm run typecheck && npm run build",
    "lint:ci": "npx --yes @biomejs/biome@2.3.0 lint src tests scripts vite.config.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.2.1",
    "preact": "^10.27.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "jsdom": "^31.0.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
